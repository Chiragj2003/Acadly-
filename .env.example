# ==============================================================================
# ACADLY - TUITION & COACHING MANAGEMENT MOBILE APP
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT CONFIGURATION (Mobile App Client)
# ------------------------------------------------------------------------------
# Obtain from: https://supabase.com/dashboard/project/<project-ref>/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ------------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY (Mobile Client Public Key)
# ------------------------------------------------------------------------------
# Obtain from: https://dashboard.razorpay.com/app/keys
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId

# ------------------------------------------------------------------------------
# 3. EXPO PUSH NOTIFICATIONS & EAS
# ------------------------------------------------------------------------------
# Obtain from: https://expo.dev/accounts/[account]/projects/[project]
EXPO_PUBLIC_PROJECT_ID=your-expo-project-uuid-here

# ==============================================================================
# SERVER-SIDE ONLY: SUPABASE EDGE FUNCTION SECRETS
# Set these via Supabase CLI: supabase secrets set KEY=VALUE
# NEVER prefix these with EXPO_PUBLIC_ or bundle them into client JavaScript!
# ==============================================================================

# Supabase Admin Service Role (for background triggers and webhooks)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Razorpay Webhook & Order Secret
# RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_passphrase

# Google Cloud OAuth 2.0 Credentials (for YouTube Resumable Uploads)
# Obtain from Google Cloud Console > APIs & Services > Credentials
# YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret
# YOUTUBE_REFRESH_TOKEN=your-long-lived-google-refresh-token
